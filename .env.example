# AZTG-MC Azure Environment Configuration Example
AZURE_TENANT_ID=your-tenant-id-here
AZURE_SUBSCRIPTION_ID=your-subscription-id-here
RESOURCE_GROUP_NAME=NHI-ZTA-Research

# Reader SPs (Class 0)
SP_READER_1_CLIENT_ID=your-client-id
SP_READER_1_SECRET=your-secret
