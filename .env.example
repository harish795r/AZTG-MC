SP_READER_2_SECRET=your-secret
SP_READER_3_CLIENT_ID=your-client-id
SP_READER_3_SECRET=your-secret

# Contributor SPs (Class 1)
SP_CONTRIB_1_CLIENT_ID=your-client-id
SP_CONTRIB_1_SECRET=your-secret
SP_CONTRIB_2_CLIENT_ID=your-client-id
SP_CONTRIB_2_SECRET=your-secret
SP_CONTRIB_3_CLIENT_ID=your-client-id
SP_CONTRIB_3_SECRET=your-secret

# Owner SPs (Class 2)
SP_OWNER_1_CLIENT_ID=your-client-id
SP_OWNER_1_SECRET=your-secret
